int sampleTriangleTable(int u, int v) {
	return triangle_table_buffer.triangles[u * 16 + v];
}

float terrainSurface = 0.5;
int getCubeConfiguration(float[8] cube) {
	int configurationIndex = 0;
	for (int i = 0; i< 8; i++) {
		if (cube[i] > terrainSurface) {
			configurationIndex |= 1 << i;
		}
	}
	return configurationIndex;
}
int ivec3toint(ivec3 coord) { 
	return coord.z + coord.y * 33 + coord.x * 33 * 33;
}

float SampleTerrain(vec3 coord) {
	return density_buffer.density[ivec3toint(ivec3(coord))];
}

bool fuzzyeq(vec3 a, vec3 b) {
	return (abs(a.x - b.x) + abs(a.y - b.y) + abs(a.z - b.z)) < 0.001;
}

// https://stackoverflow.com/questions/63315810/is-there-an-efficient-way-to-append-values-in-an-ssb-in-a-compute-shader-with-gl
int VertForIndice(vec3 vertex){
	// comment out this for loop to flat shade
	for (int i = 0; i < params.numberOfVertices; i++) {
		if (fuzzyeq(my_data_buffer.vertices[i], vertex)) {
			return i;
		}
	}
	int index = int(atomicAdd(params.numberOfVertices, 1));
	my_data_buffer.vertices[index] = vertex;
	return index;
}


void MarchCube(ivec3 _position) {
	float[8] cube;
	for (int i = 0; i < 8; i++) {
		cube[i] = SampleTerrain(_position + CornerTable[i]);
	}
	
	int configIndex = getCubeConfiguration(cube);
		
	if (configIndex == 0 || configIndex == 255) {
		return;
	}
	int edgeIndex = 0;
	
	for (int i = 0; i < 5; i++) {
		int[3] tri;
		
		for (int p = 0; p < 3; p++) {
			//int indice = TriangleTable[configIndex][edgeIndex];
			int indice = sampleTriangleTable(configIndex, edgeIndex);
			
			if (indice == -1) {
				return;
			}
				
			vec3 vert1 = _position + EdgeTable[indice][0]; // negligible ms
			vec3 vert2 = _position + EdgeTable[indice][1];
			
			float vert1sample = cube[EdgeIndexes[indice][0]];
			float vert2sample = cube[EdgeIndexes[indice][1]];
			
			float difference = vert2sample - vert1sample;
			if (difference == 0) {
				difference = terrainSurface;
			} else {
				difference = (terrainSurface - vert1sample) / difference;
			}
			vec3 vertPosition = vert1 + ((vert2 - vert1) * difference);
			
			int vert = VertForIndice(vertPosition); // 7ms
			tri[p] = vert;
			edgeIndex += 1;
		}
		int index = int(atomicAdd(params.numberOfTriangles, 3));
		triangle_buffer.triangles[index + 0] = tri[0];
		triangle_buffer.triangles[index + 1] = tri[1];
		triangle_buffer.triangles[index + 2] = tri[2];
		
		vec3 a = my_data_buffer.vertices[tri[0]];
		vec3 b = my_data_buffer.vertices[tri[1]];
		vec3 c = my_data_buffer.vertices[tri[2]];
		
		vec3 normal = cross(normalize(a-b), normalize(c-b));
		
		for (int p = 0; p < 3; p++) {
			vec3 existing = normal_buffer.normals[tri[p]];
			if (fuzzyeq(existing, vec3(0, 0, 0))) {
				normal_buffer.normals[tri[p]] = normal;
			} else {
				normal_buffer.normals[tri[p]] = (normal + existing) / 2.0;
			}
		}
		
	}
	
}


void main() {

	MarchCube(ivec3(gl_GlobalInvocationID.xyz));
}
