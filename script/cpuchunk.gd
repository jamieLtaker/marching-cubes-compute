extends StaticBody3D

@export var noiseidk:FastNoiseLite

@export var chunkCoord:Vector3i

var vertices:= PackedVector3Array()
var triangles:= PackedInt32Array()
#var uvs := PackedVector2Array()
var normals := PackedVector3Array()

var terrainSurface:float = 0.5
var width:int = 32
var terrainMap = []

func getCubeConfiguration(cube:Array[float])->int:
	var configurationIndex:int = 0
	for i in range (0, 8):
		if cube[i] > terrainSurface:
			configurationIndex |= 1 << i
	return configurationIndex

func MarchCube(_position:Vector3i)->void:
	
	
	var cube :Array[float] = []
	cube.resize(8)
	for i in range(0, 8):
		cube[i] = SampleTerrain(_position + CornerTable[i])
	
	var configIndex:int = getCubeConfiguration(cube)

		
	if configIndex == 0 or configIndex == 255:
		return
		
	var edgeIndex:int = 0
	for i in range(0, 5):
		var verticesAdded = 0
		var prevVerticesSize = vertices.size()
		for p in range (0, 3 ):
			var indice:int = TriangleTable[configIndex][edgeIndex]
			
			if (indice == -1):
				return
				
			var vert1:Vector3 = Vector3(_position) + EdgeTable[indice][0]
			var vert2:Vector3 = Vector3(_position) + EdgeTable[indice][1]
			
			var vert1sample = cube[EdgeIndexes[indice][0]]
			var vert2sample = cube[EdgeIndexes[indice][1]]
			
			var difference:float = vert2sample - vert1sample
			if difference == 0:
				difference = terrainSurface
			else:
				difference = (terrainSurface - vert1sample) / difference
			
			var vertPosition:Vector3 = vert1 + ((vert2 - vert1) * difference)
			
			triangles.push_back(VertForIndice(vertPosition))
			verticesAdded += vertices.size() - prevVerticesSize
			prevVerticesSize = vertices.size()
			edgeIndex += 1
		var edge1:Vector3 = vertices[triangles[triangles.size() - 2]] - vertices[triangles[triangles.size() - 3]]
		var edge2:Vector3 = vertices[triangles[triangles.size() - 1]] - vertices[triangles[triangles.size() - 2]]
		var normal = -edge1.cross(edge2)
		for k in range(0, verticesAdded):
			normals.push_back(normal)

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	var beginTime = Time.get_ticks_msec()
	
	PopulateTerrainMap()
	createMeshData()
	if vertices.size() == 0:
		return
	BuildMesh()
	
	var endTime = Time.get_ticks_msec()
	print("Regular chunk time: " + str(endTime - beginTime))
	
	position = chunkCoord * width
	

		
func PopulateTerrainMap() -> void:
	terrainMap.resize(width + 1)
	for x in range(0, width + 1):
		terrainMap[x] = []
		terrainMap[x].resize(width + 1)
		for y in range(0, width + 1):
			terrainMap[x][y] = []
			terrainMap[x][y].resize(width + 1)
			for z in range(0, width + 1):
				var thisHeight:float = float(width) * noiseidk.get_noise_2d(float(x + chunkCoord.x * width) + 0.1, float(z + chunkCoord.z * width) + 0.1) * 0.2 + 8
				
				
				terrainMap[x][y][z] = thisHeight - float(y + chunkCoord.y * width)
				
func createMeshData() -> void:
	for x in range(0, width ):
		for y in range(0, width ):
			for z in range(0, width):
				MarchCube(Vector3i(x, y, z))

func SampleTerrain(coord:Vector3i)->float:
	return terrainMap[coord.x][coord.y][coord.z]

func VertForIndice(vert:Vector3)->int:
	for i in range(0, vertices.size()):
		if vertices[i].is_equal_approx(vert):
			return i;
	vertices.append(vert)
	#uvs.append(Vector2.ZERO)
	#normals.append(Vector3.UP)
	return vertices.size() - 1
			
func clearMeshData() -> void:
	vertices.clear()
	triangles.clear()
	
func BuildMesh():
	
	var _mesh:= ArrayMesh.new()
	var arrays = []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = vertices 
	#triangles.reverse()
	arrays[Mesh.ARRAY_INDEX] = triangles
	arrays[Mesh.ARRAY_NORMAL] = normals
	
	
	
	_mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	
	$MeshInstance3D.mesh = _mesh
	$CollisionShape3D.shape = _mesh.create_trimesh_shape()

